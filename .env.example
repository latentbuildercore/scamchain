# ==============================================================================
# SCAMCHAIN — Environment Configuration Template
# AI-Powered Threat Investigation & Scam Campaign Correlation
# ==============================================================================
# Copy this file to .env.local for local development. Never commit real keys.

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# ------------------------------------------------------------------------------
# Google Gemini API (Investigation & Correlation Engine)
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# Google Cloud Platform & Firestore (Persistence & Graph Storage)
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=scamchain-hackathon-2026
FIRESTORE_DATABASE_ID=(default)
# Path to service account JSON (optional if running in Cloud Run with IAM)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ------------------------------------------------------------------------------
# Security Intelligence Providers (Optional / Future Phases)
# ------------------------------------------------------------------------------
# Google Web Risk / Safe Browsing API v4
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_key_here
# VirusTotal API v3 (Optional signal enrichment)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
