# ==============================================================================
# SCAMCHAIN — Environment Configuration Template
# AI-Powered Threat Investigation & Scam Campaign Correlation
# ==============================================================================
# Copy this file to .env.local for local development. Never commit real keys.
#
# NOTE ON SERVERLESS (VERCEL) DEPLOYMENT:
# - Do not assume Firestore or Google Safe Browsing is active just because an
#   environment variable exists. Both services degrade gracefully to built-in
#   heuristics and ephemeral session memory if credentials are missing or fail.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE AI ENGINE (REQUIRED FOR LIVE INVESTIGATIONS)
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio (https://aistudio.google.com/)
# REQUIRED for live Gemini 2.0 multimodal image/text analysis and threat extraction.
# If omitted or left as placeholder, deterministic heuristic analysis is used.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 2. APPLICATION RUNTIME & DEMO CONFIGURATION (OPTIONAL)
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Enables deterministic threat scenario triggers for the C-17 campaign demo
# (defaults to true for evaluation and review)
NEXT_PUBLIC_DEMO_MODE=true

# ------------------------------------------------------------------------------
# 3. DURABLE PERSISTENCE — GOOGLE CLOUD FIRESTORE (OPTIONAL)
# ------------------------------------------------------------------------------
# In serverless runtimes (Vercel), functions have ephemeral containers and a
# read-only filesystem. Without Cloud Firestore credentials, investigations
# use ephemeral in-memory session cache for the active container lifecycle.
# Setting these enables durable cross-instance Firestore storage.
# (Leave as placeholder or comment out to run in ephemeral standalone mode)
GOOGLE_CLOUD_PROJECT=scamchain-hackathon-2026
FIRESTORE_DATABASE_ID=(default)
# Set to 'true' only if you have populated Firestore with campaign collections:
USE_FIRESTORE=false

# ------------------------------------------------------------------------------
# 4. EXTERNAL THREAT INTELLIGENCE (OPTIONAL)
# ------------------------------------------------------------------------------
# Google Safe Browsing API v4 (Optional reputation check)
# If omitted or if quota is exhausted, URL pipeline completes safely without error.
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_key_here
